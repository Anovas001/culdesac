# Public base URL, without a trailing slash. Used only by server code.
APP_URL=http://localhost:3000
APP_PORT=3000
APP_TIMEZONE=Europe/Madrid

# Docker PostgreSQL. Use a long unique password in production. If you use
# characters reserved by URLs (@, :, /, ?, #), percent-encode them in DATABASE_URL.
POSTGRES_DB=culdesac
POSTGRES_USER=culdesac
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://culdesac:change-this-local-password@db:5432/culdesac?schema=public

# One administrator. Generate the hash with: npm run admin:hash -- "your password"
ADMIN_EMAIL=admin@example.com
# Keep bcrypt hashes quoted: Docker Compose otherwise interprets their `$` signs.
ADMIN_PASSWORD_HASH='$2b$12$replace-with-a-bcrypt-hash'
# Generate a unique value, e.g. `openssl rand -base64 48`.
SESSION_SECRET=replace-with-a-long-random-secret-of-at-least-32-characters

# Stripe test credentials for local development. Do not use live credentials locally.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Local development logs confirmation email instead of sending it.
EMAIL_MODE=console
# Required only when EMAIL_MODE=resend.
RESEND_API_KEY=
EMAIL_FROM=Fortnite Tournaments <noreply@example.com>
